# Copy to .env (or export these in the server environment) to send real texts.
# Without these, the app runs in simulation mode: texts are logged in the
# Messages screen but not actually sent.

# Twilio credentials — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional
# PORT=3000
# DATA_DIR=./data
