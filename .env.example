# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead.

# --- Required ---

# Postgres connection string. For Supabase: Dashboard → Connect →
# Connection string → use the *pooler* URI (port 6543) for Vercel.
DATABASE_URL=

# Staff login password for the web app. Without it the app is open to
# anyone who has the URL — always set this on a public deployment.
STAFF_PASSWORD=

# --- Optional: real SMS via Twilio (https://console.twilio.com) ---
# Without these, the app runs in simulation mode: texts are logged in the
# Messages screen but not actually sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional ---
# PORT=3000
